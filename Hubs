local sgui = Instance.new("ScreenGui")
sgui.Name = "DeltaJayHub"
sgui.ResetOnSpawn = false

-- Safe Delta Environment Loader
local parentSuccess, parentObject = pcall(function()
    return gethui and gethui() or game:GetService("CoreGui")
end)

if parentSuccess and parentObject then
    sgui.Parent = parentObject
else
    sgui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

-- FIXED: Explicitly capitalized "Frame" 
local panel = Instance.new("Frame")
panel.Name = "SmallPanel"
panel.Size = UDim2.new(0, 250, 0, 200)
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.new(0.5, 0, 0.5, 0)
panel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = sgui

local panelText = Instance.new("TextLabel")
panelText.Name = "PanelText"
panelText.Size = UDim2.new(1, 0, 0.4, 0)
panelText.Position = UDim2.new(0, 0, 0.3, 0)
panelText.BackgroundTransparency = 1
panelText.TextColor3 = Color3.fromRGB(255, 255, 255)
panelText.Text = "You have opened this panel!"
panelText.Font = Enum.Font.SourceSansBold
panelText.TextSize = 20
panelText.Parent = panel
local button = Instance.new("TextButton")
button.Name = "OpenButton"
button.Size = UDim2.new(0, 150, 0, 50)
button.AnchorPoint = Vector2.new(0.5, 0.5)
button.Position = UDim2.new(0.5, 0, 0.15, 0)
button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
button.BorderSizePixel = 0
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Text = "HI BUDDY"
button.Font = Enum.Font.SourceSansBold
button.TextSize = 18
button.Parent = sgui

button.MouseButton1Click:Connect(function()
    panel.Visible = not panel.Visible
    if panel.Visible then
        button.Text = "Close"
        button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        button.Text = "Open"
        button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end)
